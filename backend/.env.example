# Example environment variables for muskul.ai backend
# Copy this file to .env and fill in your values

# Runtime environment (development, production, staging)
RUN_MODE=development

# Database Configuration
MUSKUL__DATABASE__URL=postgresql://postgres:postgres@localhost:5432/muskul_dev
MUSKUL__DATABASE__MAX_CONNECTIONS=10
MUSKUL__DATABASE__MIN_CONNECTIONS=2

# MongoDB Configuration
MUSKUL__MONGODB__URL=mongodb://localhost:27017
MUSKUL__MONGODB__DATABASE=muskul_activities_dev

# Redis Configuration
MUSKUL__REDIS__URL=redis://localhost:6379/0
MUSKUL__REDIS__MAX_CONNECTIONS=10

# Authentication
MUSKUL__AUTH__JWT_SECRET=your-secret-key-here
MUSKUL__AUTH__JWT_EXPIRATION_HOURS=24

# Strava Provider
MUSKUL__PROVIDERS__STRAVA__CLIENT_ID=your-strava-client-id
MUSKUL__PROVIDERS__STRAVA__CLIENT_SECRET=your-strava-client-secret
MUSKUL__PROVIDERS__STRAVA__REDIRECT_URI=http://localhost:8080/api/providers/strava/callback

# Garmin Provider
MUSKUL__PROVIDERS__GARMIN__CLIENT_ID=your-garmin-client-id
MUSKUL__PROVIDERS__GARMIN__CLIENT_SECRET=your-garmin-client-secret
MUSKUL__PROVIDERS__GARMIN__REDIRECT_URI=http://localhost:8080/api/providers/garmin/callback

# Observability
MUSKUL__OBSERVABILITY__OTLP_ENDPOINT=http://localhost:4317
MUSKUL__OBSERVABILITY__SERVICE_NAME=muskul-backend-dev

# Rust Logging
RUST_LOG=debug
