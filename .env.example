# =============================================================================
# muskul.ai - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
RUST_ENV=development
RUST_LOG=info,muskul_backend=debug,sqlx=warn

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL Database (Structured Data)
# -----------------------------------------------------------------------------
# Connection string format: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/muskul_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=muskul_dev
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_IDLE_TIMEOUT=600

# -----------------------------------------------------------------------------
# MongoDB Database (Raw Provider Data)
# -----------------------------------------------------------------------------
# Connection string format: mongodb://user:password@host:port/database
MONGODB_URI=mongodb://mongo:mongo@localhost:27017/muskul_dev
MONGODB_DATABASE=muskul_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Valkey/Redis Cache
# -----------------------------------------------------------------------------
REDIS_URL=redis://:valkey@localhost:6379
REDIS_MAX_CONNECTIONS=10
REDIS_CONNECT_TIMEOUT=5
REDIS_RESPONSE_TIMEOUT=10
REDIS_KEY_PREFIX=muskul:

# -----------------------------------------------------------------------------
# Azure Service Bus (Message Queue)
# -----------------------------------------------------------------------------
# Production: Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=...
# Development: Use emulator connection string
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost:5672;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<your-key>
SERVICE_BUS_QUEUE_NAME=fitness-data-ingestion
SERVICE_BUS_MAX_CONCURRENT_CALLS=16
SERVICE_BUS_MAX_AUTO_LOCK_RENEWAL_DURATION=300

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=<your-jwt-secret-key-here>
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_ISSUER=muskul.ai
JWT_AUDIENCE=muskul.ai-api

# -----------------------------------------------------------------------------
# Password Hashing (Argon2)
# -----------------------------------------------------------------------------
ARGON2_MEMORY_SIZE=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# -----------------------------------------------------------------------------
# OAuth2 - Strava Provider
# -----------------------------------------------------------------------------
STRAVA_CLIENT_ID=<your-strava-client-id>
STRAVA_CLIENT_SECRET=<your-strava-client-secret>
STRAVA_REDIRECT_URI=http://localhost:3000/api/v1/providers/strava/callback
STRAVA_SCOPE=activity:read_all,profile:read_all
STRAVA_AUTHORIZATION_URL=https://www.strava.com/oauth/authorize
STRAVA_TOKEN_URL=https://www.strava.com/oauth/token
STRAVA_API_BASE_URL=https://www.strava.com/api/v3

# -----------------------------------------------------------------------------
# OAuth2 - Garmin Provider
# -----------------------------------------------------------------------------
GARMIN_CLIENT_ID=<your-garmin-client-id>
GARMIN_CLIENT_SECRET=<your-garmin-client-secret>
GARMIN_REDIRECT_URI=http://localhost:3000/api/v1/providers/garmin/callback
GARMIN_SCOPE=activities,profile
GARMIN_AUTHORIZATION_URL=https://connect.garmin.com/oauthConfirm
GARMIN_TOKEN_URL=https://connectapi.garmin.com/oauth-service/oauth/access_token
GARMIN_API_BASE_URL=https://apis.garmin.com/wellness-api

# -----------------------------------------------------------------------------
# OAuth2 - Apple Health (HealthKit)
# -----------------------------------------------------------------------------
APPLE_HEALTH_CLIENT_ID=<your-apple-health-client-id>
APPLE_HEALTH_CLIENT_SECRET=<your-apple-health-client-secret>
APPLE_HEALTH_REDIRECT_URI=http://localhost:3000/api/v1/providers/apple/callback
APPLE_HEALTH_TEAM_ID=<your-apple-team-id>
APPLE_HEALTH_KEY_ID=<your-apple-key-id>

# -----------------------------------------------------------------------------
# OAuth2 - Fitbit Provider
# -----------------------------------------------------------------------------
FITBIT_CLIENT_ID=<your-fitbit-client-id>
FITBIT_CLIENT_SECRET=<your-fitbit-client-secret>
FITBIT_REDIRECT_URI=http://localhost:3000/api/v1/providers/fitbit/callback
FITBIT_SCOPE=activity profile heartrate sleep weight
FITBIT_AUTHORIZATION_URL=https://www.fitbit.com/oauth2/authorize
FITBIT_TOKEN_URL=https://api.fitbit.com/oauth2/token
FITBIT_API_BASE_URL=https://api.fitbit.com/1

# -----------------------------------------------------------------------------
# OAuth2 - Google Fit Provider
# -----------------------------------------------------------------------------
GOOGLE_FIT_CLIENT_ID=<your-google-fit-client-id>
GOOGLE_FIT_CLIENT_SECRET=<your-google-fit-client-secret>
GOOGLE_FIT_REDIRECT_URI=http://localhost:3000/api/v1/providers/google/callback
GOOGLE_FIT_SCOPE=https://www.googleapis.com/auth/fitness.activity.read https://www.googleapis.com/auth/fitness.body.read
GOOGLE_FIT_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_FIT_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_FIT_API_BASE_URL=https://www.googleapis.com/fitness/v1

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
MAX_FILE_UPLOAD_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=.fit,.tcx,.gpx,.csv,.json
UPLOAD_TEMP_DIR=/tmp/muskul-uploads

# -----------------------------------------------------------------------------
# OpenTelemetry (Observability)
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=muskul-backend
OTEL_SERVICE_VERSION=0.1.0
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development,service.namespace=muskul
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GRAFANA_URL=http://localhost:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Prometheus
# -----------------------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s

# -----------------------------------------------------------------------------
# Azure Application Insights (Production)
# -----------------------------------------------------------------------------
# Leave empty for development (using local OpenTelemetry)
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPINSIGHTS_INSTRUMENTATION_KEY=

# -----------------------------------------------------------------------------
# Azure Resources (Production)
# -----------------------------------------------------------------------------
# Azure Cosmos DB for MongoDB API
AZURE_COSMOS_CONNECTION_STRING=
AZURE_COSMOS_DATABASE_NAME=muskul

# Azure PostgreSQL
AZURE_POSTGRES_HOST=
AZURE_POSTGRES_PORT=5432
AZURE_POSTGRES_DATABASE=muskul
AZURE_POSTGRES_USER=
AZURE_POSTGRES_PASSWORD=
AZURE_POSTGRES_SSL_MODE=require

# Azure Cache for Redis
AZURE_REDIS_HOST=
AZURE_REDIS_PORT=6380
AZURE_REDIS_PASSWORD=
AZURE_REDIS_SSL=true

# Azure Storage Account
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=fitness-files

# Azure Container Registry
AZURE_CONTAINER_REGISTRY=
AZURE_CONTAINER_REGISTRY_USERNAME=
AZURE_CONTAINER_REGISTRY_PASSWORD=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_STRAVA_PROVIDER=true
ENABLE_GARMIN_PROVIDER=true
ENABLE_APPLE_HEALTH_PROVIDER=true
ENABLE_FITBIT_PROVIDER=true
ENABLE_GOOGLE_FIT_PROVIDER=true
ENABLE_FILE_UPLOAD=true
ENABLE_MANUAL_ENTRY=true
ENABLE_AI_AGENT=false

# -----------------------------------------------------------------------------
# AI Agent Service (Python)
# -----------------------------------------------------------------------------
AI_AGENT_SERVICE_URL=http://localhost:8000
AI_AGENT_TIMEOUT_SECONDS=30
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4

# -----------------------------------------------------------------------------
# ETL Pipeline Configuration
# -----------------------------------------------------------------------------
ETL_BATCH_SIZE=1000
ETL_MAX_RETRIES=3
ETL_RETRY_DELAY_SECONDS=5
ETL_WORKER_CONCURRENCY=4

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# -----------------------------------------------------------------------------
# Session Management
# -----------------------------------------------------------------------------
SESSION_SECRET=<your-session-secret-key>
SESSION_TIMEOUT_MINUTES=60
SESSION_COOKIE_NAME=muskul_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_MAX_AGE_SECONDS=3600
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/muskul/backend.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=30

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
ENABLE_SWAGGER_UI=true
ENABLE_GRAPHQL_PLAYGROUND=true
ENABLE_DEBUG_ENDPOINTS=true
